<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 280" width="400" height="280">
  <defs>
    <linearGradient id="bgd" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f0f1a"/>
      <stop offset="100%" style="stop-color:#1a1a2e"/>
    </linearGradient>
    <linearGradient id="truck" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#f68b1e"/>
      <stop offset="100%" style="stop-color:#ff9f3a"/>
    </linearGradient>
  </defs>
  <rect width="400" height="280" fill="url(#bgd)" rx="16"/>
  <!-- Speed lines behind truck -->
  <line x1="20" y1="140" x2="120" y2="140" stroke="#f68b1e" stroke-width="3" stroke-linecap="round" opacity="0.6"/>
  <line x1="10" y1="155" x2="100" y2="155" stroke="#f68b1e" stroke-width="2" stroke-linecap="round" opacity="0.4"/>
  <line x1="30" y1="125" x2="110" y2="125" stroke="#f68b1e" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
  <!-- Truck body -->
  <rect x="120" y="110" width="190" height="80" rx="8" fill="url(#truck)"/>
  <!-- Truck cab -->
  <rect x="300" y="118" width="65" height="72" rx="8" fill="#e07010"/>
  <!-- Windshield -->
  <rect x="308" y="126" width="48" height="36" rx="4" fill="#0f0f1a" opacity="0.7"/>
  <line x1="332" y1="126" x2="332" y2="162" stroke="#252540" stroke-width="2"/>
  <!-- Headlight -->
  <rect x="356" y="148" width="12" height="8" rx="2" fill="#fff" opacity="0.9"/>
  <!-- Wheels -->
  <circle cx="165" cy="195" r="20" fill="#0f0f1a"/>
  <circle cx="165" cy="195" r="12" fill="#252540"/>
  <circle cx="165" cy="195" r="5" fill="#f68b1e"/>
  <circle cx="280" cy="195" r="20" fill="#0f0f1a"/>
  <circle cx="280" cy="195" r="12" fill="#252540"/>
  <circle cx="280" cy="195" r="5" fill="#f68b1e"/>
  <circle cx="340" cy="195" r="16" fill="#0f0f1a"/>
  <circle cx="340" cy="195" r="9" fill="#252540"/>
  <circle cx="340" cy="195" r="4" fill="#f68b1e"/>
  <!-- Packages in truck -->
  <rect x="135" y="122" width="40" height="35" rx="4" fill="rgba(255,255,255,0.15)"/>
  <line x1="135" y1="139" x2="175" y2="139" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"/>
  <line x1="155" y1="122" x2="155" y2="157" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"/>
  <rect x="182" y="125" width="35" height="30" rx="4" fill="rgba(255,255,255,0.12)"/>
  <rect x="224" y="120" width="45" height="38" rx="4" fill="rgba(255,255,255,0.1)"/>
  <!-- Zmafrdeal logo on truck side -->
  <text x="185" y="155" font-family="Arial" font-size="12" font-weight="900" fill="white" opacity="0.9" letter-spacing="1">ZMAFRDEAL</text>
  <!-- Road -->
  <rect x="0" y="215" width="400" height="65" rx="0" fill="#252540" opacity="0.6"/>
  <line x1="0" y1="248" x2="400" y2="248" stroke="#f68b1e" stroke-width="2" stroke-dasharray="30 20" opacity="0.4"/>
  <!-- Location pin destination -->
  <circle cx="370" cy="90" r="20" fill="#f68b1e"/>
  <circle cx="370" cy="86" r="8" fill="white"/>
  <path d="M370 94 L370 108" stroke="#f68b1e" stroke-width="3" stroke-linecap="round"/>
  <text x="370" y="84" text-anchor="middle" font-family="Arial" font-size="10" font-weight="bold" fill="#f68b1e" dy="2">•</text>
  <!-- Dotted path to destination -->
  <path d="M365 120 Q370 130 365 140" fill="none" stroke="#f68b1e" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.6"/>
  <!-- 24h badge -->
  <rect x="270" y="38" width="70" height="36" rx="18" fill="#f68b1e"/>
  <text x="305" y="52" text-anchor="middle" font-family="Arial" font-size="14" font-weight="900" fill="white">24h</text>
  <text x="305" y="65" text-anchor="middle" font-family="Arial" font-size="8" fill="white" opacity="0.9">Approval Time</text>
  <!-- Bottom label -->
  <text x="200" y="248" text-anchor="middle" font-family="Arial" font-size="10" font-weight="bold" fill="#f68b1e">Fast Order Fulfillment Across Africa</text>
</svg>
